{
  "name": "egypt-vr-tour",
  "version": "0.1.0",
  "private": true,
  "description": "Shared browser and VR project base for historically plausible ancient Egyptian walkthroughs.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @egyptvr/web-tour run dev",
    "build": "npm run generate:assets && npm run validate:content && npm run validate:history && npm run validate:optimization && npm run validate:hero && npm run validate:actors && npm run validate:people && npm run build --workspaces",
    "generate:assets": "node tools/generate-runtime-assets.mjs",
    "generate:glb": "node tools/run-blender-asset-kit.mjs",
    "bake:hero": "node tools/run-blender-asset-kit.mjs --hero-bake",
    "qa:hero-camera": "node tools/print-hero-camera-lock.mjs",
    "qa:hero-capture": "node tools/capture-hero-shot.mjs",
    "qa:collisions": "node tools/capture-hero-shot.mjs collision-check --hardware --collision-audit",
    "validate:hero": "node tools/validate-hero-bake.mjs",
    "validate:actors": "node tools/validate-actor-lock.mjs",
    "build:people": "node tools/run-blender-asset-kit.mjs --hero-people",
    "validate:people": "node tools/validate-hero-people.mjs",
    "validate:content": "node tools/validate-content.mjs",
    "validate:history": "node tools/validate-historical-compliance.mjs",
    "validate:optimization": "node tools/validate-browser-optimization.mjs",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "jpeg-js": "^0.4.4"
  }
}
