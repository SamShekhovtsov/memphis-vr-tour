**/node_modules/
**/dist/
**/.vite/
**/.turbo/
**/.env
**/.env.*
**/*.log
**/__pycache__/
**/*.pyc

# Large or generated media should use source control intentionally.
**/*.mp4
**/*.mov
**/*.avi
**/*.mkv

# Excluding pictures to reduce the size of the repository - as images are auto-generated
**/*.png
**/*.jpg
**/*.jpeg
**/*.tiff
**/*.gif
**/*.webp

# Generated asset workspaces.
**/content/generated/
**/content/processed/*
!**/content/processed/
!**/content/processed/runtime-assets.manifest.json

# Unreal generated folders.
**/engines/unreal/Binaries/
**/engines/unreal/DerivedDataCache/
**/engines/unreal/Intermediate/
**/engines/unreal/Saved/

# Unity generated folders.
**/engines/unity/Library/
**/engines/unity/Logs/
**/engines/unity/Temp/
**/engines/unity/Obj/
**/engines/unity/Build/
**/engines/unity/Builds/
# Intentional immutable inputs for the finished-street atlas orientation audit.
!content/source-assets/lighting/steps78-base/*.png

# Immutable exterior repair inputs and requested visual comparisons.
!content/source-assets/lighting/exterior-repair/baseline/*.png
!content/source-assets/lighting/exterior-repair/baseline/*.webp
!docs/design/screenshots/hero-street-main-district-north-before.png
!docs/design/screenshots/hero-street-main-district-north-after.png
!docs/design/screenshots/hero-street-main-district-hands-before.png
!docs/design/screenshots/hero-street-main-district-hands-after.png

# Requested image-quality before/after evidence.
!docs/design/screenshots/*-image-quality-before.png
!docs/design/screenshots/*-image-quality-after.png

!docs/design/screenshots/*-image-quality-route-before.png
!docs/design/screenshots/*-image-quality-route-after.png
